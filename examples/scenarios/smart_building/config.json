{
  "variables": {
    "NODE161": {
      "name": "node-161",
      "host": "10.34.64.161",
      "username": "ubuntu"
    },
    "NODE162": {
      "name": "node-162",
      "host": "10.34.64.162",
      "username": "ubuntu"
    },
    "NODE163": {
      "name": "node-163",
      "host": "10.34.64.163",
      "username": "ubuntu"
    },
    "NODE164": {
      "name": "node-164",
      "host": "10.34.64.164",
      "username": "ubuntu"
    }
  },

  "api": {
    "kafka_host": "${NODE161}"
  },

  "generate": [
    {
      "amount": 4,
      "node": "${NODE161}",
      "name": "energy_sensor",
      "to": ["kafka"],
      "resources": {
        "type": "data",
        "source": "examples/scenarios/smart_building/generator/energy_sensor",
        "destination": "/energy_sensor"
      },
      "executables": {
        "type": "tmux",
        "session": "EnergySensor",
        "destination": "/energy_sensor/start.sh",
        "commands": [
          "cd /energy_sensor",
          "cargo run -- -l debug --interval 250"
        ]
      },
      "docker": {
        "dockerfile": "images/rust.dockerfile",
        "image": "rust_base",
        "name": "energy_sensor"
      },
      "attach": {
        "kafka_producer": {
          "topics": ["EnergyIn"],
          "address": "${NODE162.host}:9092",
          "logger": "${NODE161.host}:9092",
          "api_port": 5000
        }
      }
    }
  ],

  "process": [
    {
      "node": "${NODE162}",
      "name": "energy_filter",
      "to": ["kafka"],
      "resources": {
        "type": "data",
        "source": "examples/scenarios/smart_building/processor/energy_filter",
        "destination": "/energy_filter"
      },
      "executables": {
        "type": "tmux",
        "destination": "/energy_filter/start.sh",
        "session": "EnergyFilter",
        "commands": [
          "cd /energy_filter",
          "cargo run -- --consumer broker:29092 --producer broker:29092 --consumer-topic EnergyIn --producer-topic EnergyFiltered -l debug"
        ]
      },
      "docker": {
        "dockerfile": "images/rust.dockerfile",
        "image": "rust_base",
        "name": "energy_filter"
      }
    },
    {
      "node": "${NODE162}",
      "name": "kafka",
      "to": [
        "energy_filter",
        "energy_aggregator",
        "mongodb_adapter",
        "postgres_adapter"
      ],
      "kafka": {
        "topics": ["EnergyIn", "EnergyFiltered", "EnergyAggregated"]
      }
    },
    {
      "node": "${NODE162}",
      "name": "energy_aggregator",
      "to": ["kafka"],
      "resources": {
        "type": "data",
        "source": "examples/scenarios/smart_building/processor/energy_aggregator",
        "destination": "/energy_aggregator"
      },
      "executables": {
        "type": "tmux",
        "destination": "/energy_aggregator/start.sh",
        "session": "EnergyAggregator",
        "commands": [
          "cd /energy_aggregator",
          "cargo run -- --consumer broker:29092 --producer broker:29092 --consumer-topic EnergyFiltered --producer-topic EnergyAggregated -l debug"
        ]
      },
      "docker": {
        "dockerfile": "images/rust.dockerfile",
        "image": "rust_base",
        "name": "energy_aggregator"
      }
    }
  ],

  "store": [
    {
      "name": "mongodb",
      "node": "${NODE163}",
      "type": "mongodb"
    },
    {
      "node": "${NODE164}",
      "name": "postgres",
      "schema": "examples/scenarios/smart_building/store/energy_store_postgres/energy.sql",
      "postgres": {
        "postgres_db": "energy"
      }
    },
    {
      "node": "${NODE163}",
      "name": "mongodb_adapter",
      "to": ["mongodb"],
      "resources": {
        "type": "data",
        "source": "examples/scenarios/smart_building/store/energy_store_mongodb",
        "destination": "/energy_store_mongodb"
      },
      "executables": {
        "type": "tmux",
        "destination": "/energy_store_mongodb/start.sh",
        "session": "MongodbAdapter",
        "commands": [
          "cd /energy_store_mongodb",
          "cargo run -- -l debug --consumer-topic EnergyFiltered --consumer 10.34.64.162:9092 --database testdb --collection testcollection --mongo-address mongodb:27017 --user mongo --password mongo"
        ]
      },
      "docker": {
        "dockerfile": "images/rust.dockerfile",
        "image": "rust_base",
        "name": "mongodb_adapter"
      }
    },
    {
      "node": "${NODE164}",
      "name": "postgres_adapter",
      "to": ["postgres"],
      "resources": {
        "type": "data",
        "source": "examples/scenarios/smart_building/store/energy_store_postgres",
        "destination": "/energy_store_postgres"
      },
      "executables": {
        "type": "tmux",
        "destination": "/energy_store_postgres/start.sh",
        "session": "PostgresAdapter",
        "commands": [
          "cd /energy_store_postgres",
          "cargo run -- -l debug --consumer-topic EnergyAggregated --consumer 10.34.64.162:9092"
        ]
      },
      "docker": {
        "dockerfile": "images/rust.dockerfile",
        "image": "rust_base",
        "name": "rust"
      }
    }
  ]
}
