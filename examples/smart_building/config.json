{
  "variables": {
    "NODE161": {
      "name": "node-161",
      "host": "10.34.64.161",
      "username": "ubuntu"
    },
    "NODE162": {
      "name": "node-162",
      "host": "10.34.64.162",
      "username": "ubuntu"
    },
    "NODE163": {
      "name": "node-163",
      "host": "10.34.64.163",
      "username": "ubuntu"
    }
  },
  "generate":
  [
    {
      "amount": 4,
      "node": "${NODE161}",
      "file": {
        "name": "rust",
        "path": "examples/smart_building/generator/energy_sensor",
        "destination": "energy_sensor/",
        "start": "start.sh"
      },
      "docker": {
        "dockerfile": "rust",
        "name": "rust"
      }
    }
  ],
  "process":
  [
    {
      "node": "${NODE162}",
      "file": {
        "name": "rust",
        "path": "examples/smart_building/processor/energy_processor",
        "destination": "energy_processor",
        "start": "start.sh"
      },
      "docker": {
        "dockerfile": "images/rust.dockerfile",
        "image": "rust"
      }
    },
    {
      "node": "${NODE162}",
      "kafka": {
        "topics": ["Energy_In", "Energy_Out"]
      },
      "docker": {
        "names": ["kafka-broker", "kafka-rest"]
      }
    }
  ],

  "store": [
    {
      "node": "${NODE163}",
      "type": "mongodb",

      "docker": {
        "name": "mongodb"
      }
    }
  ]
}