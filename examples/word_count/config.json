{
  "variables": {
    "NODE161": {
      "name": "node-161",
      "host": "10.34.64.161",
      "username": "ubuntu"
    },
    "NODE162": {
      "name": "node-162",
      "host": "10.34.64.162",
      "username": "ubuntu"
    },
    "NODE163": {
      "name": "node-163",
      "host": "10.34.64.163",
      "username": "ubuntu"
    },
    "NODE166": {
      "name": "node-166",
      "host": "10.34.64.166",
      "username": "ubuntu"
    }
  },

  "api": {
      "kafka_host": "${NODE164}"
  },

  "generate":
  {
    "node": "${NODE161}",
    "name": "WordGenerator",
    "to": ["word-splitter"],
    "docker_data": {
      "name": "word-generator",
      "path": "examples/word_count/generator",
      "destination": "/word-generator",
      "start": "/word-generator/start.sh"
    },
    "docker": {
      "dockerfile": "images/rust.dockerfile",
      "image": "rust_base",
      "name": "word-generator"
    },
    "attach": {
      "kafkaproducer": {
        "topics": ["EnergyIn"],
        "address": "${NODE162.host}:9092",
        "api_port": 5000
      }
    }
  },

  "process":
  [
    {
      "node": "${NODE162}",
      "name": "word-splitter",
      "to": ["postgres"],
      "docker": {
        "dockerfile": "images/rust.dockerfile",
        "image": "rust_base",
        "name": "word-splitter"
      }
    },
    {
      "node": "${NODE162}",
      "name": "Apache Kafka",
      "kafka": {
        "topics": ["Sentence", "Word"]
      }
    }
  ],

  "store":
  [
    {
      "name": "postgres-adapter",
      "docker_data": {
        "name": "word-generator",
        "path": "examples/word_count/store",
        "destination": "/postgres-adapter",
        "start": "/postgres-adapter/start.sh"
      },
      "docker": {
        "dockerfile": "images/rust.dockerfile",
        "image": "rust_base",
        "name": "postgres-adapter"
      }
    },
    {
      "node": "${NODE163}",
      "name": "postgres",
      "schema": "examples/word_count/store/words.sql",
      "postgres": {
        "postgres_db": "words"
      }
    }
  ]
}
