{
  "variables": {
    "NODE161": {
      "name": "node-161",
      "host": "10.34.64.161",
      "username": "ubuntu"
    },
    "NODE162": {
      "name": "node-162",
      "host": "10.34.64.162",
      "username": "ubuntu"
    },
    "NODE163": {
      "name": "node-163",
      "host": "10.34.64.163",
      "username": "ubuntu"
    },
    "NODE164": {
      "name": "node-164",
      "host": "10.34.64.164",
      "username": "ubuntu"
    }
  },

  "api": {
      "kafka_host": "${NODE164}"
  },

  "generate":
  {
    "node": "${NODE161}",
    "name": "sentence_generator",
    "to": ["kafka"],
    "resources": {
      "type": "data",
      "name": "sentence_generator",
      "path": "examples/word_count/sentence_generator",
      "destination": "/sentence_generator"
    },
    "executables": {
      "type": "tmux",
      "session": "SentenceGenerator",
      "path": "/sentence_generator/start.sh",
      "commands": [
        "cd /sentence_generator",
        "cargo run -- --producer ${NODE162.host}:9092 --topic SentenceGenerator -l debug --interval 1"
      ]
    },
    "docker": {
      "dockerfile": "images/rust.dockerfile",
      "image": "rust_base",
      "name": "sentence_generator"
    },
    "attach": {
      "kafka_producer": {
        "topics": ["Sentence"],
        "address": "${NODE162.host}:9092",
        "logger": "${NODE164.host}:9092",
        "api_port": 5000
      }
    }
  },

  "process":
  [
    {
      "node": "${NODE162}",
      "name": "sentence_splitter",
      "to": ["kafka"],
      "resources": {
        "type": "data",
        "name": "sentence_splitter",
        "path": "examples/word_count/sentence_splitter",
        "destination": "/sentence_splitter"
      },
      "executables": {
        "type": "tmux",
        "session": "SentenceSplitter",
        "path": "/sentence_splitter/start.sh",
        "commands": [
          "cd /sentence_splitter",
          "cargo run -- --consumer broker:29092 --producer broker:29092 --consumer-topic Sentence --producer-topic Word -l debug"
        ]
      },
      "docker": {
        "dockerfile": "images/rust.dockerfile",
        "image": "rust_base",
        "name": "sentence_splitter"
      }
    },
    {
      "node": "${NODE162}",
      "name": "kafka",
      "to": ["postgres_adapter"],
      "kafka": {
        "topics": ["Sentence", "Word"]
      }
    }
  ],

  "store":
  [
    {
      "node": "${NODE163}",
      "name": "postgres_adapter",
      "to": ["postgres"],
      "resources": {
        "type": "data",
        "name": "word-generator",
        "path": "examples/word_count/postgres_adapter",
        "destination": "/postgres_adapter"
      },
      "executables": {
        "type": "tmux",
        "session": "PostgresAdapter",
        "path": "/postgres_adapter/start.sh",
        "commands": [
          "cd /postgres_adapter",
          "cargo run -- -l debug --topic Word --consumer ${NODE162.host}:9092"
        ]
      },
      "docker": {
        "dockerfile": "images/rust.dockerfile",
        "image": "rust_base",
        "name": "postgres_adapter"
      }
    },
    {
      "node": "${NODE163}",
      "name": "postgres",
      "schema": "examples/word_count/postgres_adapter/words.sql",
      "postgres": {
        "postgres_db": "words"
      }
    }
  ]
}
