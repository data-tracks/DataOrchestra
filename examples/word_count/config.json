{
  "process":
    [
      {
        "type": "kafka",
        "config": {
          "topics": "words"
        }
      }
    ],
  "generate":
    [
      {
        "data": "examples/word_count/generate",
        "start": "examples/word_count/generate/setup.sh",
        "image": "python",
        "config": {
          "name": "generate"
        }
      }
    ],
  "store":
    [
      {
        "data": "examples/word_count/store",
        "schema": "examples/word_count/store/schema.sql",
        "start": "examples/word_count/store/setup.sh",
        "type": "postgres",
        "name": "store",
        "docker": {
          "name": "store"
        },
        "config": {
          "postgres_db": "store"
        }
      }
    ]
}
