{
  "variables": {
        "NODE161": {
          "name": "node-161",
          "host": "10.34.64.161",
          "username": "ubuntu"
        },
        "NODE162": {
          "name": "node-162",
          "host": "10.34.64.162",
          "username": "ubuntu"
        },
        "NODE163": {
          "name": "node-163",
          "host": "10.34.64.163",
          "username": "ubuntu"
        },
        "NODE163": {
          "name": "node-163",
          "host": "10.34.64.163",
          "username": "ubuntu"
        }
    },

    "api": {
        "kafka_host": "${NODE164}"
    },

    "generate": 
    {
        "node": "${NODE161}",
        "name": "WordGenerator",
        "docker_data": {
            "name": "word-generator",
            "path": "examples/word_count/generator",
            "destination": "/word-generator",
            "start": "/word-generator/start.sh"
        },
        "docker": {
            "dockerfile": "images/rust.dockerfile",
            "image": "rust_base",
            "name": "word-generator"
        }
    },

    "process": 
    [
        {
            "node": "${NODE162}",
            "name": "word-splitter",
            "docker": {
                "dockerfile": "images/rust.dockerfile",
                "image": "rust_base",
                "name": "word-splitter"
            }
        },
        {
            "node": "${NODE162}",
            "name": "Apache Kafka",
            "kafka": {
                "topics": ["Sentence", "Word"]
            }
        }
    ],

    "store": 
    [
        {
            "name": "postgres-adapter",
            "docker": {
                "dockerfile": "images/rust.dockerfile",
                "image": "rust_base",
                "name": "word-generator"
            }   
        },
        {
            "node": "${NODE163}",
            "name": "postgres",
            "type": "postgres"
        }
    ]
}
